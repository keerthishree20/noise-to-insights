# Copy to .env and fill in.

# Theming needs ONE of these keys. Without either, upload and column profiling
# still work, but an analysis stops at the theming step. GET /api/health reports
# which provider is in use.
#
# Anthropic (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini (free tier): https://aistudio.google.com/apikey
# Used automatically when ANTHROPIC_API_KEY is empty.
GEMINI_API_KEY=

# Optional overrides -- the defaults below are what the app uses if unset.
# LLM_PROVIDER=anthropic        # or gemini; forces one when both keys are set
# MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.5-flash

# The single origin the API allows. Use localhost, not 127.0.0.1, to match
# whatever you open in the browser.
FRONTEND_URL=http://localhost:5173

# Uploads and the DuckDB database. Disposable -- delete the directory to reset.
# DATA_DIR=./data

# Below this many open-text responses, clustering is skipped and the responses
# are themed directly.
# MIN_RESPONSES_FOR_CLUSTERING=25
